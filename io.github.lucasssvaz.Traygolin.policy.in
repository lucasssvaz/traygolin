<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Traygolin</vendor>
  <vendor_url>https://github.com/lucasssvaz/traygolin</vendor_url>
  <icon_name>io.github.lucasssvaz.Traygolin</icon_name>
  <action id="io.github.lucasssvaz.Traygolin.tunnel">
    <description>Connect or disconnect the Pangolin tunnel</description>
    <message>Authentication is required to change the Pangolin VPN connection</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@HELPER@</annotate>
  </action>
</policyconfig>
